# AERIS environment configuration -- copy to .env and edit.
#   Copy-Item .env.example .env
#
# Only the two AERIS_* variables below are read by the code today
# (node3_service/store.py and node3_service/api.py). Everything under
# "not yet wired" is documentation of intent, not behaviour.
#
# NOTE: nothing here is loaded automatically -- there is no python-dotenv
# dependency. Set these in your shell before starting the service:
#   $env:AERIS_DB = "C:\aeris_data\aeris.db"

# ---------------------------------------------------------------------
# ACTIVE
# ---------------------------------------------------------------------

# SQLite database path. Default: <repo>/data/aeris.db
# Keep this OUTSIDE any cloud-synced folder. A WAL-mode SQLite file whose
# .db and -wal are copied out of step by a sync client can be corrupted;
# store.py prints a warning if it detects OneDrive/Dropbox/GDrive/iCloud.
AERIS_DB=C:\aeris_data\aeris.db

# SHAP warm-up. "1" (default) costs ~7 s at boot and makes /explain and
# the first attribution instant. "0" skips it: boot drops to ~0.2 s and
# /explain returns 503. Use 0 while iterating on tests, 1 for demos.
AERIS_EXPLAIN=1

# ---------------------------------------------------------------------
# NOT YET WIRED -- listed so the intent is recorded, ignored by the code
# ---------------------------------------------------------------------

# Gate decision threshold. Currently hard-coded to 0.65 in predictor.py.
# WARNING: tuning this does not fix the gate. Live traces show it moves
# 0.116 in probability for a 0.003 change in input, then saturates -- no
# threshold makes a near-chance classifier usable. Retrain instead.
# AERIS_GATE_THRESHOLD=0.65

# Uvicorn bind address / port, if you script the launch.
# AERIS_HOST=127.0.0.1
# AERIS_PORT=8000

# Frames a slow dashboard may fall behind before its oldest is dropped.
# Hard-coded as QUEUE_MAX=16 in node3_service/ingest.py.
# AERIS_WS_QUEUE_MAX=16